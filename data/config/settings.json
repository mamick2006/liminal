  # --- The Standing Linkage, the furnishing this mod declares into Captain's Quarters ---------
  # Captain's Quarters polls each flag and grants its furnishing when the flag turns true. This one
  # is the research-started presence flag, so the Linkage arrives with the research team and never
  # before it. No code on either side.
  "cq_quest_rewards": {
    "$liminality_research": "liminal_standing_linkage"
  },
  # Research points granted each time the furnishing pays out. Capped at 3 in code.
  "liminal_cq_linkage_rp_per_month": 1,
  # Economy month ends between payouts, clamped to 1 to 12 in code. The shipped pair is worth a
  # third of an RP a month, under what the loop pays at the minimum research investment.
  "liminal_cq_linkage_period_months": 3,
  # Percent off hull and armor damage taken, every player ship, in the Avatar fight only. Vanilla's
  # comparable reductions: 25 for one ship (Damage Control, Impact Mitigation), 20 fleet-wide but
  # fighters only (Carrier Command), 10 for one ship conditionally (Systems Expertise elite).
  "liminal_cq_linkage_boss_damage_reduction": 15,

  # --- LunaLib defaults ------------------------------------------------------------------------
  # Defaults for the LunaLib rows of the same keys, read when LunaLib is not installed.
  "liminal_mgmt_intel_only": false,
  "liminal_rpmult": 4,
  "liminal_templateopmult": 1.0,
  "liminal_template_op_override": 0,
  "liminal_crisis_enabled": true,
  "liminal_crisis_begins": 300,
  "liminal_crisis_difficulty": "Standard",
  "liminal_npc_influence_chance": 10,
  "liminal_boss_compute": 0.4,
  "liminal_boss_difficulty": "Standard",

  # --- Template capacity ----------------------------------------------------------------------
  # Defaults for the three LunaLib rows of the same keys, read when LunaLib is not installed.
  # Free capacity each template starts with.
  "liminal_capacity_start": 3,
  # Total credits to raise a template from its starting capacity to 5.
  "liminal_capacity_price": 200000,
  # Each further 5 capacity costs this many times the 5 before.
  "liminal_capacity_price_growth": 5,

  # --- Survival Mode -------------------------------------------------------------------------
  # The default for the LunaLib row of the same key, read when LunaLib is not installed. On: in a
  # Survival Mode save every credit price this mod charges is multiplied by the factor below.
  "liminal_survival_adjustments": true,
  # The factor: template capacity, the research investment minimum and the entry price. Between 0
  # and 1; anything else changes nothing.
  "liminal_survival_credit_mult": 0.5,

  # --- The Linkage Shop, the Work this mod declares into Nomad Flotilla -----------------------
  # Capacity every Liminal Template gains while the Work stands. The Work's effect line in
  # data/config/nomad/nomad_work_sizes.csv states the same number.
  "liminal_nomad_linkage_shop_capacity": 2
}